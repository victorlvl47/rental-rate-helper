{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node dist/worker.js",
    "temporal:smoke": "node dist/smoke-client.js",
    "test": "vitest run --exclude src/integration/**",
    "test:temporal-retry": "pnpm --filter shared build && pnpm --filter pricing build && pnpm --filter database build && vitest run src/integration/temporal-pricing-retry.integration.test.ts"
  },
  "dependencies": {
    "@temporalio/client": "^1.13.2",
    "@temporalio/worker": "^1.13.2",
    "@temporalio/workflow": "^1.13.2",
    "dotenv": "^17.4.2"
    ,"database":"workspace:*","pricing":"workspace:*","shared":"workspace:*","drizzle-orm":"^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest":"^4.1.10"
  }
}
